# Fallback web image when Node registry pulls fail: serve a static Phase-1 shell via nginx
FROM nginx:stable-alpine
COPY infrastructure/docker/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/web-fallback/ /usr/share/nginx/html/
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --retries=8 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
