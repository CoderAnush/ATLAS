FROM python:3.11-slim AS builder

WORKDIR /app
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY infrastructure/docker/requirements-worker.txt /tmp/requirements-worker.txt
RUN python -m venv /app/.venv \
    && /app/.venv/bin/pip install --upgrade pip \
    && /app/.venv/bin/pip install -r /tmp/requirements-worker.txt

COPY packages /app/packages
COPY apps/worker /app/apps/worker
RUN /app/.venv/bin/pip install \
      /app/packages/atlas-core \
      /app/packages/atlas-telemetry \
      /app/apps/worker

FROM python:3.11-slim AS runtime

RUN groupadd --system --gid 10001 atlas || true \
    && id -u atlas >/dev/null 2>&1 || useradd --system --uid 10001 --gid atlas --home /app --shell /usr/sbin/nologin atlas

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV="/app/.venv" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/apps/worker /app/apps/worker

USER 10001
CMD ["celery", "-A", "atlas_worker.celery_app.celery_app", "worker", "--loglevel=INFO", "--concurrency=2"]
