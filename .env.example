# ATLAS environment variable template
# Copy to .env for local non-Docker runs. Compose injects values directly.

ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO
ATLAS_JSON_LOGS=true
ATLAS_SERVICE_NAME=atlas-api
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000
ATLAS_SECRET_KEY=change-me-in-production
ATLAS_ACCESS_TOKEN_MINUTES=15
ATLAS_REFRESH_TOKEN_DAYS=14
ATLAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=atlas
MINIO_SECURE=false

MLFLOW_TRACKING_URI=http://localhost:5000

OTEL_TRACES_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

NEXT_PUBLIC_API_URL=http://localhost:8000
CELERY_TASK_ALWAYS_EAGER=false
